# ============================================
# VARIÁVEIS DE AMBIENTE - COOLIFY PRODUÇÃO
# ============================================
# 
# INSTRUÇÕES:
# 1. Acesse o Coolify: https://seu-coolify.com
# 2. Vá em: Projeto FGTS Web → Environment Variables
# 3. Copie CADA linha abaixo e adicione como variável
# 4. Clique em "Save" após adicionar todas
# 5. Clique em "Restart" para aplicar
#
# ============================================

# ===== DJANGO =====
DJANGO_SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=fgts.bildee.com.br,127.0.0.1,localhost

# ===== SUPABASE POSTGRESQL (PRIMARY DATABASE) =====
SUPABASE_HOST=your-supabase-host
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-supabase-password
SUPABASE_PORT=6543

# ===== SUPABASE REST API (SECONDARY - opcional) =====
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ===== ASAAS (Pagamentos) =====
ASAAS_API_KEY=your-asaas-production-key-here
ASAAS_SANDBOX=False
# Token para autenticar webhooks recebidos do Asaas (configure no painel Asaas > Integrações > Webhooks)
ASAAS_WEBHOOK_TOKEN=your-webhook-token-here

# ===== EMAIL - BREVO (Sendinblue) =====
# IMPORTANTE: Configure estas variáveis no Coolify Environment Variables
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-api-key
DEFAULT_FROM_EMAIL=noreply@bildee.com.br

# URL pública (usada em links enviados por email)
SITE_URL=https://fgts.bildee.com.br

# ============================================
# VERIFICAÇÃO RÁPIDA
# ============================================
#
# Após salvar e reiniciar, execute no terminal do Coolify:
#
# python -c "import os; print('✓ SUPABASE_HOST:', os.getenv('SUPABASE_HOST'))"
# python -c "import os; print('✓ SUPABASE_PORT:', os.getenv('SUPABASE_PORT'))"
# python -c "import os; print('✓ DEBUG:', os.getenv('DJANGO_DEBUG'))"
#
# ============================================

# ⚠️ IMPORTANTE - GERAR SECRET_KEY FORTE:
#
# Execute no seu ambiente local:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Copie o resultado e substitua em DJANGO_SECRET_KEY acima
# ============================================
